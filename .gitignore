# Build output
/build/
/out/
/cmake-build-*/
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.dylib
*.exe
*.pdb

# CMake
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
compile_commands.json

# vcpkg
/vcpkg_installed/
/vcpkg/

# Coverage & sanitizer artifacts
*.gcda
*.gcno
*.profraw
*.profdata
/coverage/
crash-*
fuzz-*.log

# Test-generated disk images (fixtures are committed; generated ones are not)
/tests/fixtures/generated/

# IDE / editor
.vs/
.vscode/
.idea/
*.user
*.swp
.cache/

# OS
.DS_Store
Thumbs.db

# Local assistant/session state (not project deliverables)
.remember/

# libFuzzer appends every newly discovered unit to the corpus directory it is
# given. Only the curated seeds are tracked; regenerate them with
# tools/fuzz/make_seed_corpus.py. Crash/timeout artifacts stay local too.
/tests/fuzz/corpus/*/*
!/tests/fuzz/corpus/*/.gitkeep
!/tests/fuzz/corpus/*/*.bin
crash-*
timeout-*
oom-*
leak-*

# Python bytecode from the lint and benchmark tooling.
__pycache__/
*.pyc
